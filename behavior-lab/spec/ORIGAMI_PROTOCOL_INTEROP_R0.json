{
  "contract_id": "tlaloc.origami-protocol-interop.r0",
  "status": "EXPERIMENTAL_REFERENCE_IMPLEMENTED",
  "purpose": "Evaluate whether different models can read and write an Origami protocol message through declared semantic codecs without undeclared external decoding or unnecessary escalation into the exact plane.",
  "target_contracts": [
    "origami.protocol.r0",
    "origami.codec-registry.r0",
    "origami.capability-negotiation.r0"
  ],
  "modes": ["READ","WRITE","ROUNDTRIP","MULTIHOP"],
  "reference_core_codecs": {"decoder":"S2","encoder":"E2"},
  "semantic_dimensions": ["entities","relations","hierarchy","evidence","uncertainty"],
  "metrics": [
    "decoder_discovery_rate",
    "encoder_discovery_rate",
    "entity_preservation",
    "relation_preservation",
    "hierarchy_preservation",
    "evidence_preservation",
    "uncertainty_preservation",
    "invented_fact_rate",
    "semantic_drift",
    "cross_model_read_success",
    "cross_model_write_success",
    "undeclared_external_codec_dependencies",
    "semantic_to_exact_escalations"
  ],
  "reference_gates": {
    "semantic_drift_max": 0.05,
    "invented_fact_rate_max": 0.0,
    "undeclared_external_codec_dependencies": 0,
    "semantic_to_exact_escalations": 0,
    "false_exact": 0
  },
  "judge": "DETERMINISTIC_STRUCTURAL_COMPARISON_NO_LLM_JUDGE",
  "hard_invariants": [
    "MODEL_A_NE_MODEL_B_ALLOWED",
    "SELF_DECLARED_SEMANTIC_CODEC_ALLOWED",
    "UNDECLARED_EXTERNAL_CODEC_DEPENDENCY_FORBIDDEN",
    "SEMANTIC_QUERY_NE_EXACT_CODEC_REQUIREMENT",
    "UNKNOWN_OVER_INVENTION",
    "REAL_MODEL_EVIDENCE_NE_SYNTHETIC_HARNESS_TEST",
    "FALSE_EXACT=0"
  ]
}
