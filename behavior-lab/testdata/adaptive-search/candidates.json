          "experimental": true
        }
      ]
    },
    {
      "schema": "tlaloc.origami-visual-search.r0.candidate",
      "id": "candidate-prompt-s2-route",
      "base_profile_id": "origami.fixed-carrier.r2.profile-3",
      "mutations": [
        {
          "kind": "PROMPT",
          "target": "ROSETTA.S2.READ_SUPERINDEX",
          "value": "DECLARE_T2_LOCATION_BEFORE_DECODE",
          "rationale": "Make S2 routing explicit before semantic decoding.",
          "experimental": true
        }
      ]
    },
    {
      "schema": "tlaloc.origami-visual-search.r0.candidate",
      "id": "candidate-temporal-unrelated",
      "base_profile_id": "origami.fixed-carrier.r2.profile-3",
      "mutations": [
        {
          "kind": "TEMPORAL_STRUCTURE",
