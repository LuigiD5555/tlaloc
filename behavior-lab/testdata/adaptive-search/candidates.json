{
  "schema": "tlaloc.adaptive-search.r0.request",
  "candidates": [
    {
      "schema": "tlaloc.origami-visual-search.r0.candidate",
      "id": "candidate-layout-t2-anchor",
      "base_profile_id": "origami.fixed-carrier.r2.profile-3",
      "mutations": [
